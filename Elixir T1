<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0"/>
<title>X-Space Sailor · Sailor Piece Roblox</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Exo+2:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
html,body{height:100%;font-family:'Exo 2',sans-serif;background:#04020A;color:#F0E0FF;overflow-x:hidden;}

/* GALAXY BACKGROUND */
.galaxy-bg{position:fixed;inset:0;z-index:0;background:
  radial-gradient(ellipse at 20% 50%, rgba(120,40,200,0.15) 0%, transparent 60%),
  radial-gradient(ellipse at 80% 20%, rgba(60,20,140,0.2) 0%, transparent 50%),
  radial-gradient(ellipse at 50% 80%, rgba(80,0,160,0.12) 0%, transparent 55%),
  #04020A;overflow:hidden;}
.stars{position:absolute;inset:0;}
.star{position:absolute;border-radius:50%;background:#fff;animation:twinkle linear infinite;}
@keyframes twinkle{0%,100%{opacity:0.2;}50%{opacity:1;}}
.nebula{position:absolute;border-radius:50%;filter:blur(60px);opacity:0.18;}

/* LAYOUT */
#app{position:relative;z-index:1;min-height:100vh;}

/* AUTH SCREEN */
#auth-screen{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px;}
.auth-card{background:rgba(13,7,30,0.92);border:1px solid rgba(160,80,255,0.3);border-radius:16px;padding:36px 28px;width:100%;max-width:360px;backdrop-filter:blur(12px);}
.auth-logo{font-family:'Orbitron',monospace;font-size:20px;font-weight:900;text-align:center;margin-bottom:4px;
  background:linear-gradient(135deg,#9B4FFF,#C87FFF,#7B2FBE,#E0AEFF);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  filter:drop-shadow(0 0 10px rgba(155,79,255,0.5));}
.auth-sub{font-size:10px;color:#7A5A9A;text-align:center;letter-spacing:3px;text-transform:uppercase;margin-bottom:28px;}
.auth-tabs{display:flex;background:rgba(255,255,255,0.04);border-radius:8px;padding:3px;margin-bottom:22px;}
.auth-tab{flex:1;padding:9px;font-size:11px;letter-spacing:1px;text-transform:uppercase;font-family:'Exo 2',sans-serif;background:transparent;border:none;color:#7A5A9A;cursor:pointer;border-radius:6px;transition:all 0.2s;}
.auth-tab.active{background:linear-gradient(135deg,#6B2FBE,#9B4FFF);color:#fff;font-weight:600;}
.auth-field{margin-bottom:14px;}
.auth-label{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:#7A5A9A;display:block;margin-bottom:6px;}
.auth-input{width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(160,80,255,0.2);border-radius:8px;padding:12px 14px;font-size:14px;font-family:'Exo 2',sans-serif;color:#F0E0FF;outline:none;transition:border-color 0.2s;-webkit-appearance:none;}
.auth-input:focus{border-color:#9B4FFF;}
.auth-input::placeholder{color:#3A2A5A;}
.auth-btn{width:100%;background:linear-gradient(135deg,#6B2FBE,#9B4FFF);color:#fff;font-family:'Orbitron',monospace;font-size:11px;font-weight:700;letter-spacing:2px;padding:14px;border-radius:8px;border:none;cursor:pointer;text-transform:uppercase;margin-top:6px;transition:opacity 0.2s;}
.auth-btn:active{opacity:0.8;}
.auth-msg{font-size:11px;text-align:center;margin-top:10px;min-height:16px;}
.auth-msg.err{color:#FF4466;}
.auth-msg.ok{color:#44FF88;}
.auth-adm-link{font-size:10px;color:#3A2A5A;text-align:center;margin-top:16px;cursor:pointer;letter-spacing:1px;text-decoration:underline;}
.auth-adm-link:active{color:#9B4FFF;}

/* MAIN SITE */
#main-site{display:none;}

/* NAV */
.nav{display:flex;align-items:center;justify-content:space-between;padding:12px 20px;border-bottom:1px solid rgba(160,80,255,0.15);background:rgba(4,2,10,0.9);position:sticky;top:0;z-index:50;backdrop-filter:blur(12px);flex-wrap:wrap;gap:8px;}
.nav-logo{font-family:'Orbitron',monospace;font-size:14px;font-weight:900;
  background:linear-gradient(135deg,#9B4FFF,#C87FFF,#7B2FBE,#E0AEFF);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  filter:drop-shadow(0 0 8px rgba(155,79,255,0.6));letter-spacing:2px;}
.nav-right{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
.nav-user-info{font-size:11px;color:#9B4FFF;font-family:'Orbitron',monospace;letter-spacing:1px;}
.nav-btn{font-size:10px;padding:7px 12px;border-radius:6px;cursor:pointer;font-family:'Exo 2',sans-serif;border:none;transition:all 0.2s;font-weight:600;letter-spacing:0.5px;}
.nav-btn.cart{background:rgba(155,79,255,0.15);border:1px solid rgba(155,79,255,0.4);color:#C87FFF;position:relative;}
.nav-btn.cart:active{background:rgba(155,79,255,0.3);}
.nav-btn.hist{background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:#9A7ABB;}
.nav-btn.logout{background:rgba(255,45,45,0.1);border:1px solid rgba(255,45,45,0.3);color:#FF6677;}
.cart-dot{position:absolute;top:-4px;right:-4px;background:#FF2D2D;color:#fff;border-radius:50%;width:16px;height:16px;font-size:9px;display:flex;align-items:center;justify-content:center;font-weight:700;}

/* HERO */
.hero{text-align:center;padding:52px 24px 44px;position:relative;}
.hero-badge{display:inline-block;font-size:10px;letter-spacing:3px;text-transform:uppercase;color:#FF4466;background:rgba(255,68,102,0.1);border:1px solid rgba(255,68,102,0.3);border-radius:20px;padding:5px 14px;margin-bottom:16px;}
.hero-title{font-family:'Orbitron',monospace;font-size:clamp(28px,8vw,48px);font-weight:900;line-height:1.05;margin-bottom:12px;
  background:linear-gradient(135deg,#9B4FFF,#C87FFF,#7B2FBE,#E0AEFF);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  filter:drop-shadow(0 0 20px rgba(155,79,255,0.4));}
.hero-sub{font-size:14px;font-weight:300;color:#7A5A9A;margin-bottom:28px;max-width:380px;margin-left:auto;margin-right:auto;line-height:1.7;}
.hero-btns{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;}
.hero-btn-main{background:linear-gradient(135deg,#6B2FBE,#9B4FFF);color:#fff;font-family:'Orbitron',monospace;font-size:10px;font-weight:700;letter-spacing:2px;padding:13px 24px;border-radius:8px;cursor:pointer;border:none;text-transform:uppercase;}
.hero-btn-sec{background:transparent;color:#44DD88;font-family:'Orbitron',monospace;font-size:10px;font-weight:700;letter-spacing:2px;padding:13px 24px;border-radius:8px;cursor:pointer;border:1px solid rgba(68,221,136,0.4);text-transform:uppercase;}

/* CATALOG */
.sec-header{padding:20px 20px 0;display:flex;align-items:center;gap:10px;}
.sec-title{font-family:'Orbitron',monospace;font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:#9B4FFF;}
.sec-line{flex:1;height:1px;background:linear-gradient(90deg,rgba(155,79,255,0.3),transparent);}
.cat-tabs{display:flex;gap:6px;padding:12px 20px;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;}
.cat-tabs::-webkit-scrollbar{display:none;}
.cat-tab{font-size:10px;letter-spacing:1px;text-transform:uppercase;padding:7px 14px;border-radius:20px;cursor:pointer;border:1px solid rgba(160,80,255,0.2);background:transparent;color:#7A5A9A;font-family:'Exo 2',sans-serif;white-space:nowrap;transition:all 0.2s;font-weight:600;}
.cat-tab.active{background:linear-gradient(135deg,#6B2FBE,#9B4FFF);color:#fff;border-color:transparent;}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:10px;padding:10px 20px 24px;}
.card{background:rgba(13,7,30,0.8);border:1px solid rgba(160,80,255,0.15);border-radius:12px;padding:16px 14px;display:flex;flex-direction:column;position:relative;transition:all 0.2s;cursor:pointer;backdrop-filter:blur(4px);}
.card:hover,.card:active{border-color:rgba(155,79,255,0.5);background:rgba(20,10,45,0.9);}
.card-badge-tag{position:absolute;top:10px;right:10px;font-size:9px;letter-spacing:1px;text-transform:uppercase;padding:3px 7px;border-radius:10px;font-weight:700;}
.tag-hot{background:rgba(155,79,255,0.25);color:#C87FFF;border:1px solid rgba(155,79,255,0.4);}
.tag-rare{background:rgba(120,0,200,0.3);color:#D0AAFF;border:1px solid rgba(120,0,200,0.5);}
.tag-new{background:rgba(255,68,102,0.2);color:#FF8899;border:1px solid rgba(255,68,102,0.4);}
.card-icon{font-size:26px;margin-bottom:10px;}
.card-cat-label{font-size:9px;letter-spacing:2px;text-transform:uppercase;color:#FF4466;margin-bottom:4px;}
.card-name{font-family:'Orbitron',monospace;font-size:11px;font-weight:700;color:#E0C8FF;margin-bottom:6px;line-height:1.3;}
.card-price{font-family:'Orbitron',monospace;font-size:13px;font-weight:900;color:#9B4FFF;margin-top:auto;margin-bottom:10px;}
.card-buy-btn{width:100%;font-size:10px;letter-spacing:1px;text-transform:uppercase;padding:8px;border:1px solid rgba(155,79,255,0.5);color:#C87FFF;background:rgba(155,79,255,0.1);border-radius:6px;cursor:pointer;font-family:'Exo 2',sans-serif;font-weight:600;transition:all 0.2s;}
.card-buy-btn:active{background:rgba(155,79,255,0.3);}

/* MODALS */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,0.85);display:flex;align-items:center;justify-content:center;z-index:200;padding:16px;}
.modal-box{background:rgba(10,5,22,0.98);border:1px solid rgba(160,80,255,0.25);border-radius:14px;width:100%;max-width:400px;position:relative;max-height:90vh;overflow-y:auto;}
.modal-hdr{padding:20px 20px 0;display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;}
.modal-title{font-family:'Orbitron',monospace;font-size:12px;font-weight:700;color:#9B4FFF;letter-spacing:2px;text-transform:uppercase;}
.modal-x{background:transparent;border:none;color:#5A4A7A;font-size:20px;cursor:pointer;padding:0;line-height:1;}
.modal-x:active{color:#FF4466;}
.modal-body{padding:0 20px 20px;}
.pix-amount{font-family:'Orbitron',monospace;font-size:28px;font-weight:900;color:#FF4466;text-align:center;margin:10px 0 16px;}
.pix-card{background:rgba(155,79,255,0.08);border:1px solid rgba(155,79,255,0.2);border-radius:10px;padding:14px;margin-bottom:14px;}
.pix-lbl{font-size:9px;letter-spacing:2px;text-transform:uppercase;color:#7A5A9A;margin-bottom:6px;}
.pix-val{font-size:11px;color:#C87FFF;word-break:break-all;line-height:1.5;}
.pix-copy-btn{display:block;width:100%;margin-top:10px;background:transparent;border:1px solid rgba(155,79,255,0.4);color:#9B4FFF;padding:8px;border-radius:6px;font-size:10px;letter-spacing:1px;text-transform:uppercase;font-family:'Exo 2',sans-serif;cursor:pointer;font-weight:600;}
.pix-copy-btn:active{background:rgba(155,79,255,0.2);}
.pix-steps{font-size:12px;color:#7A5A9A;line-height:1.9;margin-bottom:16px;}
.pix-steps ol{margin-left:16px;}
.btn-green{width:100%;background:linear-gradient(135deg,#1A9A50,#22DD77);color:#04020A;font-family:'Orbitron',monospace;font-size:11px;font-weight:700;letter-spacing:2px;padding:14px;border-radius:8px;border:none;cursor:pointer;text-transform:uppercase;}
.btn-green:active{opacity:0.85;}
.btn-ghost{width:100%;background:transparent;color:#5A4A7A;font-family:'Exo 2',sans-serif;font-size:11px;padding:11px;border-radius:8px;border:1px solid rgba(255,255,255,0.08);cursor:pointer;margin-top:8px;}
.btn-ghost:active{border-color:#FF4466;color:#FF4466;}

/* CART ITEMS */
.cart-list{max-height:200px;overflow-y:auto;margin-bottom:12px;}
.cart-row{display:flex;align-items:center;justify-content:space-between;padding:9px 0;border-bottom:1px solid rgba(255,255,255,0.05);}
.cart-row-name{font-size:11px;color:#E0C8FF;font-family:'Orbitron',monospace;}
.cart-row-price{font-size:11px;color:#9B4FFF;font-weight:700;font-family:'Orbitron',monospace;}
.cart-rm{background:transparent;border:none;color:#3A2A5A;cursor:pointer;font-size:15px;padding:0 4px;}
.cart-rm:active{color:#FF4466;}
.cart-total-row{display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-top:1px solid rgba(155,79,255,0.2);margin-bottom:14px;}
.cart-total-lbl{font-size:11px;color:#7A5A9A;letter-spacing:1px;text-transform:uppercase;}
.cart-total-val{font-family:'Orbitron',monospace;font-size:17px;font-weight:900;color:#FF4466;}

/* CHAT */
#modal-chat .modal-box{max-width:440px;padding:0;display:flex;flex-direction:column;height:88vh;max-height:580px;overflow:hidden;}
.chat-hdr{background:rgba(155,79,255,0.1);padding:14px 16px;border-bottom:1px solid rgba(155,79,255,0.15);display:flex;align-items:center;gap:10px;flex-shrink:0;}
.chat-dot{width:8px;height:8px;border-radius:50%;background:#44DD88;box-shadow:0 0 6px #44DD88;flex-shrink:0;}
.chat-hdr-title{font-family:'Orbitron',monospace;font-size:11px;font-weight:700;color:#9B4FFF;letter-spacing:1px;}
.chat-hdr-sub{font-size:10px;color:#7A5A9A;margin-top:2px;}
.chat-hdr-x{margin-left:auto;background:transparent;border:none;color:#5A4A7A;font-size:18px;cursor:pointer;}
.chat-order-bar{background:rgba(4,2,10,0.6);padding:10px 16px;border-bottom:1px solid rgba(255,255,255,0.05);flex-shrink:0;}
.chat-order-lbl{font-size:9px;letter-spacing:2px;text-transform:uppercase;color:#5A4A7A;margin-bottom:3px;}
.chat-order-txt{font-size:11px;color:#E0C8FF;line-height:1.5;}
.chat-order-tot{font-family:'Orbitron',monospace;font-size:12px;font-weight:900;color:#FF4466;margin-top:2px;}
.chat-msgs{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:14px 16px;display:flex;flex-direction:column;gap:8px;background:rgba(2,1,8,0.5);}
.msg{max-width:82%;padding:9px 13px;border-radius:10px;font-size:12px;line-height:1.5;}
.msg.sys{align-self:center;background:rgba(155,79,255,0.1);border:1px solid rgba(155,79,255,0.2);color:#7A5A9A;font-size:10px;text-align:center;border-radius:20px;padding:5px 12px;max-width:92%;}
.msg.client{align-self:flex-end;background:rgba(107,47,190,0.3);color:#F0E0FF;border-radius:10px 10px 2px 10px;border:1px solid rgba(155,79,255,0.2);}
.msg.vendor{align-self:flex-start;background:rgba(13,7,30,0.8);color:#F0E0FF;border-radius:10px 10px 10px 2px;border:1px solid rgba(255,255,255,0.07);}
.msg-who{font-size:9px;font-weight:700;letter-spacing:1px;text-transform:uppercase;margin-bottom:3px;}
.msg.vendor .msg-who{color:#9B4FFF;}
.msg.client .msg-who{color:#FF4466;}
.msg-time{font-size:9px;color:#3A2A5A;margin-top:3px;text-align:right;}
.typing{align-self:flex-start;background:rgba(13,7,30,0.8);border:1px solid rgba(255,255,255,0.07);border-radius:10px 10px 10px 2px;padding:10px 14px;display:none;}
.dots{display:flex;gap:4px;align-items:center;}
.dots span{width:6px;height:6px;border-radius:50%;background:#7A5A9A;animation:bop 1s infinite;}
.dots span:nth-child(2){animation-delay:.2s;}
.dots span:nth-child(3){animation-delay:.4s;}
@keyframes bop{0%,60%,100%{transform:translateY(0);}30%{transform:translateY(-5px);}}
.chat-inp-area{border-top:1px solid rgba(255,255,255,0.07);padding:10px 12px;display:flex;gap:8px;background:rgba(10,5,22,0.95);flex-shrink:0;}
.chat-inp{flex:1;background:rgba(255,255,255,0.05);border:1px solid rgba(160,80,255,0.2);border-radius:8px;padding:10px 13px;font-size:13px;font-family:'Exo 2',sans-serif;color:#F0E0FF;outline:none;-webkit-appearance:none;}
.chat-inp:focus{border-color:#9B4FFF;}
.chat-inp::placeholder{color:#3A2A5A;}
.chat-send-btn{background:linear-gradient(135deg,#6B2FBE,#9B4FFF);color:#fff;border:none;border-radius:8px;padding:10px 14px;cursor:pointer;font-size:14px;}
.chat-send-btn:active{opacity:0.8;}

/* HISTORY MODAL */
.hist-list{max-height:400px;overflow-y:auto;}
.hist-item{border:1px solid rgba(155,79,255,0.15);border-radius:10px;padding:14px;margin-bottom:10px;background:rgba(155,79,255,0.05);}
.hist-date{font-size:10px;color:#5A4A7A;letter-spacing:1px;margin-bottom:6px;}
.hist-items{font-size:11px;color:#E0C8FF;line-height:1.6;margin-bottom:6px;}
.hist-total{font-family:'Orbitron',monospace;font-size:12px;font-weight:900;color:#9B4FFF;}
.hist-empty{font-size:12px;color:#3A2A5A;text-align:center;padding:24px 0;}

/* ADM PANEL */
#adm-panel{position:fixed;bottom:16px;right:16px;z-index:300;}
.adm-fab{background:linear-gradient(135deg,#8B0000,#FF2D2D);color:#fff;font-family:'Orbitron',monospace;font-size:10px;font-weight:700;letter-spacing:1px;padding:10px 16px;border-radius:30px;border:none;cursor:pointer;box-shadow:0 4px 20px rgba(255,45,45,0.4);}
.adm-box{display:none;position:fixed;bottom:64px;right:16px;width:320px;max-height:520px;background:rgba(10,5,22,0.98);border:1px solid rgba(255,45,45,0.25);border-radius:14px;overflow:hidden;flex-direction:column;box-shadow:0 8px 32px rgba(0,0,0,0.7);}
.adm-box.open{display:flex;}
.adm-hdr{background:rgba(255,45,45,0.1);padding:12px 16px;border-bottom:1px solid rgba(255,45,45,0.15);display:flex;align-items:center;justify-content:space-between;flex-shrink:0;}
.adm-hdr-title{font-family:'Orbitron',monospace;font-size:11px;font-weight:700;color:#FF4466;letter-spacing:1px;}
.adm-logout-btn{background:transparent;border:none;color:#5A4A7A;font-size:11px;cursor:pointer;font-family:'Exo 2',sans-serif;}
.adm-login-area{padding:18px;}
.adm-login-title{font-family:'Orbitron',monospace;font-size:11px;color:#FF4466;letter-spacing:1px;margin-bottom:14px;text-align:center;}
.adm-inp{width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,45,45,0.2);border-radius:8px;padding:10px 12px;font-size:13px;font-family:'Exo 2',sans-serif;color:#F0E0FF;outline:none;margin-bottom:8px;-webkit-appearance:none;}
.adm-inp:focus{border-color:#FF4466;}
.adm-login-btn{width:100%;background:linear-gradient(135deg,#8B0000,#FF2D2D);color:#fff;font-family:'Orbitron',monospace;font-size:10px;font-weight:700;letter-spacing:1px;padding:11px;border-radius:8px;border:none;cursor:pointer;text-transform:uppercase;}
.adm-login-btn:active{opacity:0.85;}
.adm-err{font-size:10px;color:#FF4466;text-align:center;margin-top:6px;}
.adm-main{display:none;flex-direction:column;flex:1;overflow:hidden;}
.adm-chats{overflow-y:auto;max-height:140px;border-bottom:1px solid rgba(255,45,45,0.1);flex-shrink:0;}
.adm-chat-row{padding:10px 14px;border-bottom:1px solid rgba(255,255,255,0.04);cursor:pointer;display:flex;align-items:center;justify-content:space-between;transition:background 0.15s;}
.adm-chat-row:active,.adm-chat-row.sel{background:rgba(155,79,255,0.1);}
.adm-chat-name{font-size:11px;color:#E0C8FF;font-family:'Orbitron',monospace;font-size:10px;}
.adm-chat-prev{font-size:10px;color:#5A4A7A;margin-top:2px;}
.adm-unread{background:#9B4FFF;color:#fff;border-radius:50%;width:16px;height:16px;font-size:9px;display:flex;align-items:center;justify-content:center;font-weight:700;}
.adm-msgs{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:10px;background:rgba(2,1,8,0.5);display:flex;flex-direction:column;gap:6px;min-height:100px;}
.adm-inp-row{border-top:1px solid rgba(255,255,255,0.07);padding:10px;display:flex;gap:8px;background:rgba(10,5,22,0.95);flex-shrink:0;}
.adm-msg-inp{flex:1;background:rgba(255,255,255,0.05);border:1px solid rgba(160,80,255,0.2);border-radius:8px;padding:9px 12px;font-size:12px;font-family:'Exo 2',sans-serif;color:#F0E0FF;outline:none;-webkit-appearance:none;}
.adm-send{background:linear-gradient(135deg,#6B2FBE,#9B4FFF);color:#fff;border:none;border-radius:8px;padding:9px 13px;cursor:pointer;font-size:13px;}

/* WA / FOOTER */
.wa-sec{padding:36px 20px;text-align:center;border-top:1px solid rgba(155,79,255,0.1);}
.wa-title{font-family:'Orbitron',monospace;font-size:12px;font-weight:700;letter-spacing:2px;color:#9B4FFF;margin-bottom:8px;text-transform:uppercase;}
.wa-sub{font-size:13px;font-weight:300;color:#5A4A7A;margin-bottom:20px;}
